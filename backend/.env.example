# ShiftFit Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env to Git.

# Supabase project URL (from Project Settings > API)
SUPABASE_URL=

# Supabase anon / publishable key (from Project Settings > API)
SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL connection string (from Connect > Session Pooler tab > URI)
# Format: postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# URL-encode any special characters in the password (e.g. @ -> %40, # -> %23)
DATABASE_URL=