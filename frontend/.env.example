# ShiftFit Frontend — Environment Variables
# Copy to .env.local for local development. Never commit .env.local to Git.
# In production (Vercel), set VITE_API_BASE_URL to the deployed API URL.

# Backend API URL
# Local development: http://localhost:8000
# Production (Vercel): https://<your-app>.vercel.app
VITE_API_BASE_URL=http://localhost:8000